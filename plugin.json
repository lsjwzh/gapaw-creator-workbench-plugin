{
  "schema": 1,
  "id": "gapaw-creator-workbench",
  "name": "Gapaw 达人工作台",
  "version": "0.12.0",
  "description": "按十个业务步骤组织达人运营；资料、文案、事件、消息、谈判和导出均由插件内置 Rust 与独立业务库处理，无需旧服务。支持保留原库的完整迁入；不自动发送消息。",
  "engine": {
    "type": "command",
    "binary": "bin/gapaw-creator-workbench",
    "binaryPlatformDir": "bin"
  },
  "commands": [
    "status",
    "configure",
    "prepare-operation",
    "record-dispatch",
    "record-error",
    "list-operations",
    "result-contract",
    "get-result",
    "submit-result",
    "browser-status",
    "bind-browser",
    "browser-probe",
    "browser-pages",
    "browser-read-page",
    "platform-contract",
    "validate-result",
    "observation-contract",
    "preview-observation",
    "submit-observation",
    "get-observations",
    "workbench-status",
    "prepare-adoption",
    "adopt-result",
    "get-adoption",
    "reconcile-adoption",
    "workbench-list",
    "workbench-batch",
    "outreach-status",
    "outreach-configure",
    "outreach-creators",
    "prepare-drafts",
    "draft-context",
    "submit-drafts",
    "get-drafts",
    "adopt-draft",
    "adopt-negotiation",
    "workbench-home",
    "workbench-creator",
    "workbench-conversations",
    "edit-draft",
    "workbench-fact-contract",
    "edit-settings",
    "record-event",
    "void-event",
    "record-message",
    "workbench-fact-status",
    "workbench-export",
    "local-workbench-status",
    "local-workbench-init",
    "preview-workbench-import",
    "import-workbench",
    "selection-status",
    "selection-environment",
    "selection-confirm-environment",
    "selection-check-environment",
    "selection-open-platform",
    "selection-create",
    "selection-prepare-turn",
    "selection-record-turn",
    "selection-contract",
    "selection-submit-list",
    "selection-preview-adoption",
    "selection-adopt",
    "selection-adoption-status",
    "selection-clear-environment"
  ],
  "ui": "ui/index.html",
  "setup": {
    "workspace": true
  }
}

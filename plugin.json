{
  "schema": 1,
  "id": "gapaw-creator-workbench",
  "name": "Gapaw 达人工作台",
  "version": "0.7.0",
  "description": "为选中达人生成邀约草稿并在比较后按版本写回现有工作台；保留选人报告、平台观测与待核验候选能力。",
  "engine": {
    "type": "command",
    "binary": "bin/gapaw-creator-workbench",
    "binaryPlatformDir": "bin"
  },
  "commands": [
    "status",
    "configure",
    "prepare-operation",
    "record-dispatch",
    "record-error",
    "list-operations",
    "result-contract",
    "get-result",
    "submit-result",
    "browser-status",
    "bind-browser",
    "browser-probe",
    "browser-pages",
    "browser-read-page",
    "platform-contract",
    "validate-result",
    "observation-contract",
    "preview-observation",
    "submit-observation",
    "get-observations",
    "workbench-status",
    "prepare-adoption",
    "adopt-result",
    "get-adoption",
    "reconcile-adoption",
    "workbench-list",
    "workbench-batch",
    "outreach-status",
    "outreach-configure",
    "outreach-creators",
    "prepare-drafts",
    "draft-context",
    "submit-drafts",
    "get-drafts",
    "adopt-draft"
  ],
  "ui": "ui/index.html",
  "setup": {
    "workspace": true
  }
}

{
  "schema": 1,
  "id": "gapaw-creator-workbench",
  "name": "Gapaw 达人工作台",
  "version": "0.8.0",
  "description": "以现有达人工作台为主体：达人列表、档案、往来对话、谈判摘要与待办；生成邀约草稿、总结对话并拟回复交给 MultiCC，比较后按版本写回。不发送消息。",
  "engine": {
    "type": "command",
    "binary": "bin/gapaw-creator-workbench",
    "binaryPlatformDir": "bin"
  },
  "commands": [
    "status",
    "configure",
    "prepare-operation",
    "record-dispatch",
    "record-error",
    "list-operations",
    "result-contract",
    "get-result",
    "submit-result",
    "browser-status",
    "bind-browser",
    "browser-probe",
    "browser-pages",
    "browser-read-page",
    "platform-contract",
    "validate-result",
    "observation-contract",
    "preview-observation",
    "submit-observation",
    "get-observations",
    "workbench-status",
    "prepare-adoption",
    "adopt-result",
    "get-adoption",
    "reconcile-adoption",
    "workbench-list",
    "workbench-batch",
    "outreach-status",
    "outreach-configure",
    "outreach-creators",
    "prepare-drafts",
    "draft-context",
    "submit-drafts",
    "get-drafts",
    "adopt-draft",
    "adopt-negotiation",
    "workbench-home",
    "workbench-creator",
    "workbench-conversations",
    "edit-draft"
